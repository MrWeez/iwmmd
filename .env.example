# Copy this file to .env before starting Compose.
# Every application variable uses the IWMMD_ prefix.
#
# Generate a master key with:
#   docker run --rm ghcr.io/mrweez/iwmmd:latest gen-key
# or:
#   go run ./cmd/iwmmd gen-key
IWMMD_SECRET_KEY=

# Public URL used for links and OIDC callbacks.
IWMMD_BASE_URL=http://localhost:8080

# Compose-only settings.
IWMMD_IMAGE=ghcr.io/mrweez/iwmmd:latest
IWMMD_BIND_ADDR=127.0.0.1
IWMMD_PORT=8080

# Optional database override. The default lives under IWMMD_DATA_DIR.
# IWMMD_DB_DSN=file:/data/iwmmd.db?_pragma=journal_mode(WAL)

# OIDC is the only authentication method. Leave the issuer blank until you
# have a provider and callback URL ready.
IWMMD_OIDC_PROVIDER=generic
IWMMD_OIDC_ISSUER=
IWMMD_OIDC_CLIENT_ID=
IWMMD_OIDC_CLIENT_SECRET=
# IWMMD_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
IWMMD_OIDC_REDIRECT_URL=
IWMMD_OIDC_SCOPES=openid,profile,email,groups
IWMMD_OIDC_GROUPS_CLAIM=groups
IWMMD_OIDC_EMAIL_CLAIM=email
IWMMD_OIDC_NAME_CLAIM=name
IWMMD_OIDC_ALLOWED_GROUPS=
IWMMD_OIDC_ADMIN_GROUPS=
IWMMD_OIDC_ALLOWED_EMAIL_DOMAINS=
IWMMD_OIDC_ALLOWED_EMAILS=
IWMMD_OIDC_ADMIN_EMAILS=
IWMMD_OIDC_TRUST_EMAIL_CLAIM=false

# Comma-separated CIDRs or IPs that may supply forwarded headers.
IWMMD_TRUSTED_PROXIES=

# Optional built-in TLS. When enabled, set IWMMD_BASE_URL to https://...
IWMMD_TLS_ENABLED=false
IWMMD_TLS_CERT_FILE=/certs/fullchain.pem
IWMMD_TLS_KEY_FILE=/certs/privkey.pem
IWMMD_TLS_PORT=8443
IWMMD_TLS_HTTP_REDIRECT=true
IWMMD_TLS_HSTS_MAX_AGE=31536000s

# Logging and metrics. Leave the metrics address blank to disable the
# separate listener.
IWMMD_LOG_LEVEL=info
IWMMD_LOG_FORMAT=json
IWMMD_METRICS_ADDR=
